  "assertion_review": [
    {
      "name": "both_reload_paths_reject_replacement_and_aba_without_policy_change",
      "kind": "native held external load",
      "assertion": "Both reload projections reject late replacement/ABA with unchanged policy, retain exact current cache and emit no extra watch change. A failed loop does not establish later combinations."
    },
    {
      "name": "cleared_external_credentials_are_not_restored_by_held_load",
      "kind": "native public clear",
      "assertion": "Release held resolve after clear; cache remains None, registry remains absent, reload reports no change. Not durable logout proof."
    },
    {
      "name": "same_owner_token_change_rejects_an_older_reload_candidate",
      "kind": "native same-owner credential change",
      "assertion": "Generation changes while owner_generation stays fixed; held guarded reload is skipped and newer exact token remains."
    },
    {
      "name": "actual_native_loaded_value_or_absence_requires_unchanged_cache",
      "kind": "real native load then private commit",
      "assertion": "Real ephemeral Some/None candidates commit on unchanged/no-op cache and reject newer cache. Barrier is after actual load, not a blocked filesystem read; loop failures stop later cases."
    },
    {
      "name": "failure_from_before_aba_does_not_poison_restored_credentials",
      "kind": "native deferred Permanent metadata",
      "assertion": "A-to-B-to-A while Permanent load is held must preserve restored credentials without attaching old failure metadata."
    },
    {
      "name": "loaded_candidate_cannot_publish_into_another_manager",
      "kind": "foreign native owner",
      "assertion": "Actual candidate cannot publish into a different manager. Existing policy identity may already reject this on the red baseline; it is a regression guard, not uniquely revision-caused proof."
    },
    {
      "name": "retained_endpoint_uses_new_credentials_after_old_external_load_finishes",
      "kind": "actual retained provider HTTP",
      "assertion": "Same provider/endpoint Arc: hold old resolve, publicly install B, release A2; exact B cache and identity, one loopback request with B Authorization and unique returned models."
    },
    {
      "name": "retained_endpoint_rejects_stale_external_load_after_credential_aba",
      "kind": "actual retained provider HTTP ABA",
      "assertion": "Same flow with public A-to-B-to-A; older A2 must not replace current A. Cache assertion precedes HTTP result unwrapping, so a red cache failure does not prove later header/response assertions executed."
    }
  ],
