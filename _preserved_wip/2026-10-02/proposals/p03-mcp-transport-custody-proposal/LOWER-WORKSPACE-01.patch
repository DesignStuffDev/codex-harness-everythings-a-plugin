+    // rather than only cancelling a waiter of its result.
+    let child_retained = owner.state.child.try_lock().is_ok_and(|slot| slot.is_some());
+    let stderr_retained = owner.state.stderr.try_lock().is_ok_and(|slot| slot.is_some());
+    drop(stdin);
