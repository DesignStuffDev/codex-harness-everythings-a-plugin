+        let generation = Generation::new(&publication);
+        let cancellation = publication.cancellation_token();
+        let barrier = Arc::new(Barrier::new(2));
+        let abandon_barrier = Arc::clone(&barrier);
+        let observer = std::thread::spawn(move || {
