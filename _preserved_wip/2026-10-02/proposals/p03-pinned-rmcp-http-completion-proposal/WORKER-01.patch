 impl<W: Worker> WorkerTransport<W> {
+    /// Cancel and observe the original worker without moving its handle into
+    /// the observer future. Cancelling this borrow leaves the same handle here;
+    /// repeated successful observations return the same immutable completion.
+    ///
+    /// The caller must retain this transport while observation is pending.
+    /// This does not bound task destructors, runtime teardown or HTTP internals.
+    /// None means the legacy `Transport::close` already consumed the handle
+    /// without retaining an observation; it must not be interpreted as clean.
+    pub async fn close_observed(&mut self) -> Option<Arc<WorkerCompletion<W::Error>>> {
+        if let Some(completion) = &self.observed_completion {
+            return Some(Arc::clone(completion));
+        }
+        self.ct.cancel();
+        let result = self.join_handle.as_mut()?.await;
+        // No await occurs between the exact join and publication of its result.
+        let _ = self.join_handle.take();
+        let completion = Arc::new(WorkerCompletion { result });
+        self.observed_completion = Some(Arc::clone(&completion));
+        Some(completion)
+    }
+
     pub fn cancel_token(&self) -> CancellationToken {
