+/// The original task join and worker operation outcome, observed exactly once.
+/// An operation error is separate from transport-specific cleanup evidence.
+#[derive(Debug)]
+pub struct WorkerCompletion<E> {
+    result: Result<Result<(), WorkerQuitReason<E>>, tokio::task::JoinError>,
+}
+
+impl<E> WorkerCompletion<E> {
+    pub fn result(&self) -> &Result<Result<(), WorkerQuitReason<E>>, tokio::task::JoinError> {
+        &self.result
+    }
 }
 
