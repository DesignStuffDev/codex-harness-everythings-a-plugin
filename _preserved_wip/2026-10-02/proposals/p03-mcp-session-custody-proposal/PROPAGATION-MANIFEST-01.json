  "patch_sha256": "b9f2eb9d51aba9b339eb76e4a6a7344dee6b6e8dc133133109c116f16eea6f62",
  "dependency_contract": {
    "RetainedTask": "spawn(&Handle, Future<Output=Result<(),SessionShutdownFailure>>)->Arc<Self>; wait()->Result<Arc<Result<(),SessionShutdownFailure>>,TaskJoinFailure>",
    "MCP": "stop_mcp_prewarm_worker()->Result<(),TaskJoinFailure>; refresh close()+wait_closed(); McpRuntime::shutdown()->Result<(),TaskJoinFailure> (upper join-only stage)"
  },
  "wire_boundary": "CodexErrorDetails::ShutdownFailed is internal; maps existing CodexErrorInfo::InternalServerError. No app-server protocol schema variants or dependencies.",
  "known_limits": [
    "Upper MCP join errors only; lower service/transport close and process termination typed failures require separate follow-on.",
    "If managed cleanup Weak<ThreadManagerState> cannot upgrade, retained task registry holds failure but manager report cannot see it. No whole-host/MCP clean claim.",
    "Snapshot drain does not fence every new session admission; process-final MCP aggregate/admission audit remains separate.",
    "Session/MCP original errors remain in their task owners; session outcome is a bounded payload-free classification.",
    "Existing notification-only wait_until_terminated is explicitly unit; removed-owner retention prevents removal from erasing later shutdown outcome.",
    "A sticky failed session ID fences future destructive removal; normal removed clean owners retire when polled or drained.",
    "The accepted repeated error category is immutable; no automatic recovery or failure clearing."
  ],
