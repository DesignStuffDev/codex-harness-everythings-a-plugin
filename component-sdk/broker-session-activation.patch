+#![allow(clippy::expect_used, clippy::unwrap_used)]
+
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::task::Poll;
+use std::time::Duration;
+
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio::sync::Notify;
+use tokio::sync::Semaphore;
+use tokio::sync::mpsc;
+use tokio::sync::watch;
+use tokio::time::Instant;
+
+use super::CALL_SLOTS;
+use super::ComponentSession;
+use super::PendingState;
+use super::SessionInner;
+use super::Shared;
+use crate::broker_api::DependencyError;
+use crate::broker_api::DependencyErrorCode;
+use crate::broker_api::DependencyOwner;
+use crate::broker_api::HostOperationScope;
+use crate::broker_host::BrokerHost;
+use crate::broker_host::HostDependencyRegistry;
+use crate::broker_host::IN_DEPENDENCY_HANDLER;
+use crate::session_wire::Header;
+use crate::session_wire::Outgoing;
+use crate::session_wire::SessionComponent;
+
+struct Fixture {
+    session: ComponentSession,
+    regular: mpsc::Receiver<Outgoing>,
+    control: mpsc::Receiver<Outgoing>,
+}
+
+impl Fixture {
+    fn new(broker: Option<BrokerHost>) -> Self {
+        let (regular, regular_rx) = mpsc::channel(CALL_SLOTS);
+        let (control, control_rx) = mpsc::channel(CALL_SLOTS);
+        let (shutdown, _) = watch::channel(false);
+        let (completion, _) = watch::channel(None);
+        Self {
+            session: ComponentSession {
+                inner: Arc::new(SessionInner {
+                    component: SessionComponent {
+                        kind: "model_catalog".to_owned(),
+                        name: "default".to_owned(),
+                    },
+                    regular,
+                    control,
+                    shared: Arc::new(Shared {
+                        pending: Mutex::new(PendingState::default()),
+                        regular_slots: Arc::new(Semaphore::new(CALL_SLOTS)),
+                        control_slots: Arc::new(Semaphore::new(CALL_SLOTS)),
+                        closing: AtomicBool::new(false),
+                        changed: Notify::new(),
+                        completion,
+                    }),
+                    shutdown,
+                    timeout: Duration::from_secs(5),
+                    broker,
+                }),
+            },
+            regular: regular_rx,
+            control: control_rx,
+        }
+    }
+
+    fn assert_not_admitted(&mut self) {
+        let shared = &self.session.inner.shared;
+        let state = shared.pending.lock().unwrap();
+        assert_eq!(
+            (
+                state.next_id,
+                state.calls.len(),
+                shared.regular_slots.available_permits(),
+                shared.control_slots.available_permits(),
+                self.regular.try_recv().is_err(),
+                self.control.try_recv().is_err(),
+            ),
+            (0, 0, CALL_SLOTS, CALL_SLOTS, true, true)
+        );
+    }
+}
+
+fn scope() -> HostOperationScope {
+    HostOperationScope::new(
+        DependencyOwner { generation: 1, identity: Some("owner".to_owned()) },
+        Instant::now() + Duration::from_secs(5),
+    )
+}
+
+fn assert_code(error: anyhow::Error, expected: DependencyErrorCode) {
+    assert_eq!(error.downcast_ref::<DependencyError>().unwrap().code, expected);
+}
+
+#[tokio::test]
+async fn failed_scoped_admission_preserves_next_id_and_all_capacity() {
+    let broker = BrokerHost::new(HostDependencyRegistry::new());
+    let mut fixture = Fixture::new(Some(broker.clone()));
+    let cancelled = scope();
+    cancelled.cancellation.cancel();
+    let mut expired = scope();
+    expired.deadline = Instant::now();
+    for (scope, expected) in [
+        (cancelled, DependencyErrorCode::Cancelled),
+        (expired, DependencyErrorCode::DeadlineExceeded),
+    ] {
+        assert_code(
+            fixture.session.call_scoped("refresh", json!({}), scope).await.unwrap_err(),
+            expected,
+        );
+        fixture.assert_not_admitted();
+        assert!(broker.scope_for_parent(1).is_none());
+    }
+    let (_receiver, cleanup) = fixture.session
+        .start("refresh", json!({}), /*cleanup*/ None, Some(scope()))
+        .await.unwrap();
+    assert!(cleanup.is_none());
+    assert!(matches!(fixture.regular.recv().await.unwrap().header, Header::Request { id: 1, .. }));
+    assert!(broker.scope_for_parent(1).is_some());
+}
+
+#[tokio::test]
+async fn nonnegotiated_session_rejects_scope_without_admission() {
+    let mut fixture = Fixture::new(None);
+    assert_code(
+        fixture.session.call_scoped("refresh", json!({}), scope()).await.unwrap_err(),
+        DependencyErrorCode::UnsupportedVersion,
+    );
+    fixture.assert_not_admitted();
+}
+
+#[tokio::test]
+async fn full_scope_table_does_not_consume_forward_id_or_capacity() {
+    let broker = BrokerHost::new(HostDependencyRegistry::new());
+    for parent in 100..100 + CALL_SLOTS as u64 {
+        broker.scope(parent, scope()).unwrap();
+    }
+    let mut fixture = Fixture::new(Some(broker.clone()));
+    assert_code(
+        fixture.session.call_scoped("refresh", json!({}), scope()).await.unwrap_err(),
+        DependencyErrorCode::Busy,
+    );
+    fixture.assert_not_admitted();
+    broker.finish_parent(100);
+    let (_receiver, _) = fixture.session
+        .start("refresh", json!({}), /*cleanup*/ None, Some(scope()))
+        .await.unwrap();
+    assert!(matches!(fixture.regular.recv().await.unwrap().header, Header::Request { id: 1, .. }));
+}
+
+#[tokio::test]
+async fn held_session_reentry_is_rejected_before_reserving_either_lane() {
+    for broker in [None, Some(BrokerHost::new(HostDependencyRegistry::new()))] {
+        let mut fixture = Fixture::new(broker);
+        IN_DEPENDENCY_HANDLER.scope((), async {
+            assert_code(
+                fixture.session.call("refresh", json!({})).await.unwrap_err(),
+                DependencyErrorCode::ReentrantCall,
+            );
+            assert_code(
+                fixture.session.call_scoped("refresh", json!({}), scope()).await.unwrap_err(),
+                DependencyErrorCode::ReentrantCall,
+            );
+            assert_code(
+                fixture.session.call_with_cleanup("prepare", json!({}), "release", json!({}))
+                    .await.unwrap_err(),
+                DependencyErrorCode::ReentrantCall,
+            );
+            assert_code(fixture.session.close().await.unwrap_err(), DependencyErrorCode::ReentrantCall);
+        }).await;
+        fixture.assert_not_admitted();
+        assert!(!fixture.session.inner.shared.closing.load(std::sync::atomic::Ordering::Acquire));
+    }
+}
+
+#[tokio::test]
+async fn rejected_release_still_detaches_pre_authorized_unscoped_cleanup() {
+    let broker = BrokerHost::new(HostDependencyRegistry::new());
+    let mut fixture = Fixture::new(Some(broker.clone()));
+    let (_receiver, cleanup) = fixture.session
+        .start("prepare", json!({}), Some(("release".to_owned(), json!({}))), /*scope*/ None)
+        .await.unwrap();
+    let outgoing = fixture.regular.recv().await.unwrap();
+    IN_DEPENDENCY_HANDLER.scope((), async {
+        assert_code(cleanup.unwrap().release().await.unwrap_err(), DependencyErrorCode::ReentrantCall);
+    }).await;
+    let cleanup = fixture.control.recv().await.unwrap();
+    assert!(matches!(cleanup.header, Header::Request { id: 2, is_control: true, .. }));
+    assert!(Arc::ptr_eq(cleanup.after_sent.as_ref().unwrap(), outgoing.sent.as_ref().unwrap()));
+    assert!(!cleanup.after_sent.unwrap().load(std::sync::atomic::Ordering::Acquire));
+    assert!(broker.scope_for_parent(1).is_none());
+    assert!(broker.scope_for_parent(2).is_none());
+}
+
+#[tokio::test]
+async fn waiter_cancellation_retains_scope_and_request_local_dependencies() {
+    let broker = BrokerHost::new(HostDependencyRegistry::new());
+    let mut fixture = Fixture::new(Some(broker.clone()));
+    let request_context = Arc::new(());
+    let retained = Arc::downgrade(&request_context);
+    let scope = scope().with_request_context(request_context);
+    let session = fixture.session.clone();
+    let waiter = tokio::spawn(async move { session.call_scoped("refresh", json!({}), scope).await });
+    let outgoing = fixture.regular.recv().await.unwrap();
+    assert!(matches!(outgoing.header, Header::Request { id: 1, .. }));
+    waiter.abort();
+    assert!(waiter.await.unwrap_err().is_cancelled());
+    assert_eq!(retained.strong_count(), 1);
+    assert_eq!(fixture.session.inner.shared.pending.lock().unwrap().calls.len(), 1);
+    assert!(broker.scope_for_parent(1).is_some());
+    // No reverse work was started in this admission-only fixture.
+    broker.finish_parent(1);
+    assert_eq!(retained.strong_count(), 0);
+}
+
+#[tokio::test]
+async fn cancellation_while_waiting_for_capacity_does_not_admit_a_scope() {
+    let broker = BrokerHost::new(HostDependencyRegistry::new());
+    let mut fixture = Fixture::new(Some(broker.clone()));
+    let slots = Arc::clone(&fixture.session.inner.shared.regular_slots)
+        .acquire_many_owned(CALL_SLOTS as u32).await.unwrap();
+    {
+        let call = fixture.session.call_scoped("refresh", json!({}), scope());
+        tokio::pin!(call);
+        std::future::poll_fn(|context| {
+            assert!(call.as_mut().poll(context).is_pending());
+            Poll::Ready(())
+        }).await;
+    }
+    drop(slots);
+    fixture.assert_not_admitted();
+    assert!(broker.scope_for_parent(1).is_none());
+}
