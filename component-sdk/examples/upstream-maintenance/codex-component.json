{
  "api_version": 1,
  "id": "codex.maintenance.upstream-review",
  "version": "0.3.0",
  "entrypoint": "plugin.pyz",
  "args": [],
  "dependencies": {},
  "components": [{
    "kind": "tool",
    "name": "upstream_impact_review",
    "contract_version": 1,
    "metadata": {
      "description": "Inspect an explicitly chosen local Codex revision against hash-bound lineage. Always blocks update approval; performs no fetch, source mutation or activation.",
      "input_schema": {
        "type": "object",
        "properties": {
          "contract_version": {"type": "integer", "const": 1},
          "repository": {"type": "string"},
          "lineage_index": {"type": "string"},
          "lineage_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "candidate_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "composition_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "publication_receipt": {"type": "string"},
          "publication_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "required": ["contract_version", "repository", "lineage_index", "lineage_sha256", "candidate_revision", "composition_revision"],
        "additionalProperties": false
      }
    }
  }, {
    "kind": "tool",
    "name": "upstream_source_capsule",
    "contract_version": 1,
    "metadata": {
      "description": "Prepare bounded immutable upstream source-input artifacts in component-owned state. Does not assemble, approve or activate an update.",
      "input_schema": {
        "type": "object",
        "properties": {
          "contract_version": {"type": "integer", "const": 1},
          "purpose": {"type": "string", "const": "prepare_source_inputs"},
          "review_request": {"type": "object"},
          "expected_plan_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "limits": {"type": "object"}
        },
        "required": ["contract_version", "purpose", "review_request", "expected_plan_id", "limits"],
        "additionalProperties": false
      }
    }
  }, {
    "kind": "tool",
    "name": "upstream_candidate_overlay",
    "contract_version": 1,
    "metadata": {
      "description": "Prepare bounded upstream/custom source transformations from a sealed capsule in component-owned state. Unresolved text, deletion and mode changes require review; no update is approved or activated.",
      "input_schema": {
        "type": "object",
        "properties": {
          "contract_version": {"type": "integer", "const": 1},
          "purpose": {"type": "string", "const": "prepare_candidate_overlay"},
          "source_capsule_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
          "expected_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "limits": {"type": "object"}
        },
        "required": ["contract_version", "purpose", "source_capsule_id", "expected_manifest_sha256", "limits"],
        "additionalProperties": false
      }
    }
  }]
}
